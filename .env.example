# Application
PHANTOMCARE_ENV=development
PHANTOMCARE_DATABASE_URL=sqlite:///./phantomcare.db
PHANTOMCARE_CACHE_DIR=./cache
PHANTOMCARE_ANALYSIS_DIR=./data/analysis
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sponsor integrations - leave blank until credentials are provided
COSTAR_DATA_DIR=./work/sponsor/costar-kit
VEXCEL_API_KEY=
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=

# Model provider - required only when the agent milestone is enabled
OPENAI_API_KEY=

# Interactive investigation safety. Live AI stays disabled unless every prerequisite is set.
PHANTOMCARE_AGENT_LIVE_ENABLED=false
PHANTOMCARE_AGENT_MODEL=
PHANTOMCARE_AGENT_MAX_TOOL_CALLS=8
PHANTOMCARE_AGENT_MAX_TOKENS=1200
PHANTOMCARE_AGENT_TIMEOUT_SECONDS=25
PHANTOMCARE_AGENT_MAX_RETRIES=0
PHANTOMCARE_AGENT_REQUESTS_PER_WINDOW=5
PHANTOMCARE_AGENT_RATE_WINDOW_SECONDS=60
PHANTOMCARE_AGENT_MAX_CONCURRENT=2
PHANTOMCARE_AGENT_CLIENT_HASH_SECRET=
PHANTOMCARE_AGENT_REDIS_URL=
PHANTOMCARE_AGENT_REDIS_TOKEN=

